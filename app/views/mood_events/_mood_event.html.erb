<div id="<%= dom_id mood_event %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Intensity:</strong>
    <%= mood_event.intensity %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Notes:</strong>
    <%= mood_event.notes %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Temperament:</strong>
    <%= mood_event.temperament %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= mood_event.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">When it happened was:</strong>
    <%= mood_event.when_it_happened_was %>
  </div>
</div>
