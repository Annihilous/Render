<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

<div class="flex justify-between items-center">
  <h1 class="font-bold text-4xl">Mood events</h1>
  <%= link_to "New mood event", new_mood_event_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
</div>

<div id="mood_events">
  <% if @mood_events.any? %>
    <table class="table-fixed">
      <thead class="bg-gray-100">
        <tr>
          <th class="px-4 py-2 font-semibold text-gray-700">When</th>
          <th class="px-4 py-2 font-semibold text-gray-700">Temperament</th>
          <th class="px-4 py-2 font-semibold text-gray-700">Intensity</th>
          <th class="px-4 py-2 font-semibold text-gray-700">Title</th>
          <th class="px-4 py-2 font-semibold text-gray-700">Notes</th>
          <th class="px-4 py-2 font-semibold text-gray-700">Actions</th>
        </tr>
      </thead>
      <tbody class="">
        <% @mood_events.each do |mood_event| %>
          <tr>
            <td class="px-4 py-2"><%= mood_event.when_it_happened_was&.strftime("%b %-d, %Y %l:%M%P") %></td>
            <td class="px-4 py-2"><%= mood_event.temperament %></td>
            <td class="px-4 py-2"><%= mood_event.intensity %></td>
            <td class="px-4 py-2"><%= mood_event.title %></td>
            <td class="px-4 py-2"><%= truncate(mood_event.notes, length: 50) %></td>
            <td class="px-4 py-2">
              <%= link_to "Show", mood_event%>
              <%= link_to "Edit", edit_mood_event_path(mood_event)%>
              <%= button_to "Destroy", mood_event, method: :delete, data: { turbo_confirm: "Are you sure?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center my-10 text-gray-500">No mood events found.</p>
  <% end %>
</div>
</div>
